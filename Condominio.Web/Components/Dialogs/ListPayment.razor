@using Condominio.Domain.Entities
@using Condominio.Infrastructure.Repositories
@inject FacturaMesCasaRepository FacturaMesCasaRepository


<RadzenDataGrid AllowFiltering="true"
                AllowColumnResize="true"
                AllowAlternatingRows="false"
                FilterMode="FilterMode.Advanced"
                AllowSorting="true"
                PageSize="5"
                AllowPaging="true"
                PagerHorizontalAlign="HorizontalAlign.Left"
                ShowPagingSummary="true"
                Data="@PagosList"
                ColumnWidth="300px"
                LogicalFilterOperator="LogicalFilterOperator.Or"
                SelectionMode="DataGridSelectionMode.Single">

    <Columns>
        <RadzenDataGridColumn Property="@nameof(Payments.Referencia)"
                              Filterable="false"
                              Title="Referencia"
                              Width="80px"
                              TextAlign="TextAlign.Center" />

        <RadzenDataGridColumn TItem="Payments"
                              Property="@nameof(Payments.Monto)"
                              Title="Monto"
                              Width="auto">
            <Template Context="pago">
                @pago.Monto $
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn Property="@nameof(Payments.FechaPago)"
                              Title="Fecha de Pago"
                              Width="160px" />
    </Columns>

    <!-- ✅ MENSAJE CUANDO NO HAY DATOS -->
    <EmptyTemplate>
        <div style="padding: 20px; text-align: center; color: #6c757d;">
            <RadzenIcon Icon="info" Style="font-size: 48px; color: #ccc;" />
            <RadzenText TextStyle="TextStyle.H5" Style="margin-top: 10px;">
                No hay pagos registrados
            </RadzenText>
            <RadzenText TextStyle="TextStyle.Body2">
                Haz clic en "Agregar Pago" para registrar uno nuevo.
            </RadzenText>
        </div>
    </EmptyTemplate>

</RadzenDataGrid>

