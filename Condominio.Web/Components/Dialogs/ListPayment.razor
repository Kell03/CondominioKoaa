@using Condominio.Domain.Entities
@using Condominio.Infrastructure.Repositories
@inject FacturaMesCasaRepository FacturaMesCasaRepository
@inject CuotaEspecialCasaRepository CuotaEspecialCasaRepository
@inject Radzen.DialogService DialogService


<RadzenDataGrid AllowFiltering="true"
                AllowColumnResize="true"
                AllowAlternatingRows="false"
                FilterMode="FilterMode.Advanced"
                AllowSorting="true"
                PageSize="5"
                AllowPaging="true"
                PagerHorizontalAlign="HorizontalAlign.Left"
                ShowPagingSummary="true"
                Data="@PagosList"
                ColumnWidth="300px"
                LogicalFilterOperator="LogicalFilterOperator.Or"
                SelectionMode="DataGridSelectionMode.Single">

    <Columns>

        

        <RadzenDataGridColumn Property="@nameof(Payments.Referencia)" Filterable="false" Title="Referencia" Width="120px" TextAlign="TextAlign.Center" />


        <RadzenDataGridColumn TItem="Payments"
                              Property="@nameof(Payments.Monto)"
                              Title="Monto"
                              Width="100px">
            <Template Context="pago">
                @pago.MontoFormateado $
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="Payments"
                              Property="@nameof(Payments.MontoBs)"
                              Title="Monto Bs"
                              Width="120px">
            <Template Context="pago">
                @pago.MontoBsFormateado Bs
            </Template>
        </RadzenDataGridColumn>


        <RadzenDataGridColumn TItem="Payments" Title="Fecha" Width="100px">
            <Template Context="payment">
                @payment.FechaPago.ToString("dd/MM/yyyy")
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="Payments"
                              Title="Opciones"
                              Width="120px"
                              TextAlign="TextAlign.Center">
            <Template Context="payment">
                @if (payment.Estado != "Confirmada")
                {
                    <RadzenButton Icon="check"
                                  ButtonStyle="ButtonStyle.Success"
                                  Size="ButtonSize.Small"
                                  Tooltip="Ver detalles"
                                  Click="@(() => ConfirmSend(payment))"
                                  @onclick:stopPropagation="true" />
                }
                else
                {
                    <RadzenButton Text="Confirmado"
                                  Style="background: #6c757d;"
                                  Size="ButtonSize.Small"
                                  Disabled="true"
                                  Tooltip="Confirmar pago"
                                  @onclick:stopPropagation="true" />
                }
            </Template>
        </RadzenDataGridColumn>

    </Columns>

    <!-- ✅ MENSAJE CUANDO NO HAY DATOS -->
    <EmptyTemplate>
        <div style="padding: 20px; text-align: center; color: #6c757d;">
            <RadzenIcon Icon="info" Style="font-size: 48px; color: #ccc;" />
            <RadzenText TextStyle="TextStyle.H5" Style="margin-top: 10px;">
                No hay pagos registrados
            </RadzenText>

        </div>
    </EmptyTemplate>

</RadzenDataGrid>

