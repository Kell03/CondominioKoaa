@using Condominio.Domain.Entities
@using Condominio.Infrastructure.Repositories
@inject FacturaMesCasaRepository FacturaMesCasaRepository
@inject CuotaEspecialCasaRepository CuotaEspecialCasaRepository
@inject Radzen.DialogService DialogService


@if (procesandoPago)
{
    <div style="position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.35);
        z-index: 9999;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;">

        <div style="background: white;
            padding: 30px 45px;
            border-radius: 12px;
            text-align: center;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);">

            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate"
                                       Size="ProgressBarCircularSize.Large" />

            <p style="margin-top: 15px; margin-bottom: 0; font-weight: 600;">
                Procesando pago...
            </p>

            <small style="color: gray;">
                Por favor, espere mientras se completa la operación.
            </small>
        </div>
    </div>
}

<RadzenDataGrid AllowFiltering="true"
                AllowColumnResize="true"
                AllowAlternatingRows="false"
                FilterMode="FilterMode.Advanced"
                AllowSorting="true"
                PageSize="5"
                AllowPaging="true"
                PagerHorizontalAlign="HorizontalAlign.Left"
                ShowPagingSummary="true"
                Data="@PagosList"
                ColumnWidth="300px"
                LogicalFilterOperator="LogicalFilterOperator.Or"
                SelectionMode="DataGridSelectionMode.Single">

    <Columns>

        

        <RadzenDataGridColumn Property="@nameof(Payments.Referencia)" Filterable="false" Title="Referencia" Width="120px" TextAlign="TextAlign.Center" />



        <RadzenDataGridColumn TItem="Payments"
                              Property="@nameof(Payments.Monto)"
                              Title="Monto"
                              Width="100px">
            <Template Context="pago">
                @pago.MontoFormateado $
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="Payments"
                              Property="@nameof(Payments.MontoBs)"
                              Title="Monto Bs"
                              Width="120px">
            <Template Context="pago">
                @pago.MontoBsFormateado Bs
            </Template>
        </RadzenDataGridColumn>


        <RadzenDataGridColumn TItem="Payments"
                              Property="@nameof(Payments.MontoEfectivo)"
                              Title="Efectivo"
                              Width="100px">
            <Template Context="pago">
                @pago.MontoEfectivo $
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="Payments" Title="Fecha" Width="100px">
            <Template Context="payment">
                @payment.FechaPago.ToString("dd/MM/yyyy")
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="Payments"
                              Title="Opciones"
                              Width="120px"
                              TextAlign="TextAlign.Center">
            <Template Context="payment">
                @if (payment.Estado != "Confirmada" && payment.Estado != "Rechazado")
                {
                    <RadzenButton Icon="check"
                                  ButtonStyle="ButtonStyle.Success"
                                  Size="ButtonSize.Small"
                                  Tooltip="Ver detalles"
                                  Click="@(() => ConfirmSend(payment))"
                                  @onclick:stopPropagation="true" />


                    <RadzenButton Icon="close"
                                  ButtonStyle="ButtonStyle.Danger"
                                  Size="ButtonSize.Small"
                                  Tooltip="Rechazar pago"
                                  Click="@(() => RejectPayment(payment))"
                                  @onclick:stopPropagation="true" />
                }
                else
                {
                    <RadzenButton Text="Confirmado"
                                  Style="background: #6c757d;"
                                  Size="ButtonSize.Small"
                                  Disabled="true"
                                  Tooltip="Confirmar pago"
                                  @onclick:stopPropagation="true" />
                }
            </Template>
        </RadzenDataGridColumn>

    </Columns>

    <!-- ✅ MENSAJE CUANDO NO HAY DATOS -->
    <EmptyTemplate>
        <div style="padding: 20px; text-align: center; color: #6c757d;">
            <RadzenIcon Icon="info" Style="font-size: 48px; color: #ccc;" />
            <RadzenText TextStyle="TextStyle.H5" Style="margin-top: 10px;">
                No hay pagos registrados
            </RadzenText>

        </div>
    </EmptyTemplate>

</RadzenDataGrid>

