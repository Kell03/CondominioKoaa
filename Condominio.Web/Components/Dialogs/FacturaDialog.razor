@using Condominio.Domain.Entities
@using Condominio.Domain.Interfaces.Repositories
@inject IGenericRepository<FacturaMes> FacturaMesRepository


<RadzenTemplateForm Data=@Item @onsubmit="SaveItem" Style="padding: 20px; background: #f8f9fa; border-radius: 8px;">
    <RadzenStack Gap="1.5rem">

        <!-- ✅ TÍTULO -->
        <RadzenText TextStyle="TextStyle.H5" Style="margin: 0; color: #1a2a3a; font-weight: 600; border-bottom: 2px solid #007bff; padding-bottom: 10px;">
            Nueva Factura
        </RadzenText>

        <!-- ✅ FILA: MES Y AÑO EN LÍNEA -->
        <RadzenStack Orientation="Orientation.Horizontal"
                     JustifyContent="JustifyContent.Start"
                     AlignItems="AlignItems.Center"
                     Gap="1.5rem"
                     Style="padding: 10px 0;">

            <!-- Mes -->
            <RadzenStack Orientation="Orientation.Vertical" Gap="0.3rem">
                <RadzenLabel Text="Mes" Component="MonthDropDown" Style="font-weight: 500; color: #333;" />
                <RadzenDropDown @bind-Value="@Item.Mes"
                                Data="@months"
                                TextProperty="Name"
                                ValueProperty="Value"
                                Style="width: 160px;"
                                Name="MonthDropDown" />
            </RadzenStack>

            <!-- Año -->
            <RadzenStack Orientation="Orientation.Vertical" Gap="0.3rem">
                <RadzenLabel Text="Año" Component="YearDropDown" Style="font-weight: 500; color: #333;" />
                <RadzenDropDown @bind-Value="@Item.Year"
                                Data="@years"
                                Style="width: 120px;"
                                Name="YearDropDown" />
            </RadzenStack>

        </RadzenStack>

        <!--GRID-->


<RadzenDataGrid @ref="ordersGrid" AllowAlternatingRows="false" AllowFiltering="true" AllowPaging="true" PageSize="5" AllowSorting="true" EditMode="@editMode"
                        Data="@orders" TItem="FacturaMesHijo" RowUpdate="@OnUpdateRow" RowCreate="@OnCreateRow" Sort="@Reset" Page="@Reset" Filter="@Reset" ColumnWidth="200px">
    <HeaderTemplate>
        <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="add_circle" Text="Add New Order" Click="@InsertRow" Disabled="@(editMode == DataGridEditMode.Single && ordersToInsert.Count() > 0)" />
    </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn Property="Id" Title="ID" Width="120px" Frozen="true" />


                <RadzenDataGridColumn Property="@nameof(FacturaMesHijo.Monto)" Title="Monto">
                    <Template Context="item">
                        @($"{item.Monto:F2} $")
                    </Template>
                    <EditTemplate Context="item">
                        <!-- ✅ RADZENNUMERIC AUTO-CERRADO -->
                        <RadzenNumeric @bind-Value="@item.Monto"
                                       Style="width: 100%;"
                                       Name="MontoInput" />

                        <RadzenRequiredValidator Text="El monto es requerido"
                                                 Component="MontoInput"
                                                 Popup="true" />
                    </EditTemplate>
                </RadzenDataGridColumn>


        <RadzenDataGridColumn Property="@nameof(FacturaMesHijo.Monto)" Title="Ship Name">
            <EditTemplate Context="order">
                <RadzenTextBox @bind-Value="order.Motivo" Style="width:200px; display: block" Name="Monto" aria-label="Ingresa Morivo" />
                        <RadzenRequiredValidator Text="Motivo es requerido" Component="Monto" Popup="true" />
            </EditTemplate>
        </RadzenDataGridColumn>
 
        <RadzenDataGridColumn Context="order" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Frozen="true" FrozenPosition="FrozenColumnPosition.Right">
            <Template Context="order">
                <RadzenButton Icon="add_circle" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" Click="@(() => InsertAfterRow(order))" title="Add new row after this row" Disabled="@(editMode == DataGridEditMode.Single && ordersToInsert.Count() > 0)" />
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1" Click="@(args => DeleteRow(order))" @onclick:stopPropagation="true" />
            </Template>
            <EditTemplate Context="order">
                <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@((args) => SaveRow(order))" aria-label="Save"/>
                <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@((args) => CancelEdit(order))" aria-label="Cancel"/>
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1" Click="@(args => DeleteRow(order))" aria-label="Delete" />
            </EditTemplate>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>



    </RadzenStack>
</RadzenTemplateForm>
