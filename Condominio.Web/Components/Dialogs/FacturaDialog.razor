@using Condominio.Domain.Entities
@using Condominio.Domain.Interfaces.Repositories
@using Condominio.Infrastructure.Repositories
@inject FacturaMesRepository FacturaMesRepository
@inject IGenericRepository<FacturaMesHijo> FacturaMesHijoRepository


<RadzenTemplateForm Data=@Item @onsubmit="SaveItem" Style="padding: 20px; background: #f8f9fa; border-radius: 8px;">
    <RadzenStack Gap="1.5rem">

        <!-- ✅ TÍTULO -->
        <RadzenText TextStyle="TextStyle.H5" Style="margin: 0; color: #1a2a3a; font-weight: 600; border-bottom: 2px solid #007bff; padding-bottom: 10px;">
            Nueva Factura
        </RadzenText>

        <!-- ✅ FILA: MES Y AÑO EN LÍNEA -->
        <RadzenStack Orientation="Orientation.Horizontal"
                     JustifyContent="JustifyContent.Start"
                     AlignItems="AlignItems.Center"
                     Gap="1.5rem"
                     Style="padding: 10px 0;">

            <!-- Mes -->
            <RadzenStack Orientation="Orientation.Vertical" Gap="0.3rem">
                <RadzenLabel Text="Mes" Component="MonthDropDown" Style="font-weight: 500; color: #333;" />
                <RadzenDropDown @bind-Value="@Item.Mes"
                                Data="@months"
                                TextProperty="Name"
                                ValueProperty="Value"
                                Style="width: 160px;"
                                Name="MonthDropDown" />
            </RadzenStack>

            <!-- Año -->
            <RadzenStack Orientation="Orientation.Vertical" Gap="0.3rem">
                <RadzenLabel Text="Año" Component="YearDropDown" Style="font-weight: 500; color: #333;" />
                <RadzenTextBox @bind-Value="yearInput"
                               MaxLength="4"
                               Change="@(args => OnYearChanged(Item))"
                               Placeholder="Año"
                               Style="width: 160px;" />
            </RadzenStack>

        </RadzenStack>

        <!--GRID-->


<RadzenDataGrid @ref="ordersGrid" AllowAlternatingRows="false" AllowFiltering="true" AllowPaging="true" PageSize="5" AllowSorting="true" EditMode="@editMode"
                        Data="@orders" TItem="FacturaMesHijo" RowUpdate="@OnUpdateRow" RowCreate="@OnCreateRow" Sort="@Reset" Page="@Reset" Filter="@Reset" ColumnWidth="200px">
    <HeaderTemplate>
        <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="add_circle" Text="Agregar Monto" Click="@InsertRow" Disabled="@(editMode == DataGridEditMode.Single && ordersToInsert.Count() > 0)" />
    </HeaderTemplate>
    <Columns>


                <RadzenDataGridColumn Property="@nameof(FacturaMesHijo.Monto)" Title="Monto" Width="100px">
                    <Template Context="item">
                        @($"{item.Monto:F2} $")
                    </Template>
                    <EditTemplate Context="item">
                        <!-- ✅ RADZENNUMERIC AUTO-CERRADO -->
                        <RadzenNumeric @bind-Value="@item.Monto"
                                       Style="width: 90%;"
                                       Name="MontoInput" />

                        <RadzenRequiredValidator Text="El monto es requerido"
                                                 Component="MontoInput"
                                                 Popup="true" />
                    </EditTemplate>
                </RadzenDataGridColumn>


                <RadzenDataGridColumn Property="@nameof(FacturaMesHijo.Motivo)" Title="Motivo" Width="150px">
            <EditTemplate Context="order">
                <RadzenTextBox @bind-Value="order.Motivo" Style="width: 90%; display: block" Name="Monto" aria-label="Ingresa Morivo" />
                        <RadzenRequiredValidator Text="Motivo es requerido" Component="Monto" Popup="true" />
            </EditTemplate>
        </RadzenDataGridColumn>
 
                <RadzenDataGridColumn Context="order" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" Width="60px">
            <Template Context="order">
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1" Click="@(args => DeleteRow(order))" @onclick:stopPropagation="true" />
            </Template>
            <EditTemplate Context="order">
                <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@((args) => SaveRow(order))" aria-label="Guardar"/>
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1" Click="@(args => DeleteRow(order))" aria-label="Eliminar" />
            </EditTemplate>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

        <RadzenStack Orientation="Orientation.Horizontal"
                     JustifyContent="JustifyContent.Start"
                     Gap="1rem">
            <RadzenButton ButtonType="ButtonType.Submit"
                          Text="Guardar"
                          Icon="save"
                          ButtonStyle="ButtonStyle.Success" />
       
        </RadzenStack>

    </RadzenStack>
</RadzenTemplateForm>
