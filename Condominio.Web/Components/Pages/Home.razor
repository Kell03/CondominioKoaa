@page "/"
@attribute [Authorize]
@using Condominio.Application.Services
@using Condominio.Domain.Entities
@using Condominio.Infrastructure.Repositories
@using Condominio.Web.Components.SubPages
@using Microsoft.AspNetCore.Authorization
@inject FacturaMesRepository FacturaMesRepository
@inject CuotaEspecialRepository CuotaEspecialRepository
@inject MovimientosRepository MovimientoRepository
@inject CuotaEspecialCasaRepository CuotaEspecialCasaRepository
@inject FacturaMesCasaRepository FacturaMesCasaRepository
@inject HouseRepository HouseRepository
@using Radzen
@inject BcvScraperService BcvScraper
@inject ConfiguracionMonedaRepository MonedaRepository
@using Radzen.Blazor
@inject AppState AppState
@rendermode InteractiveServer

<div style="display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center; width: 100%;">

    @if (AppState.CurrentUser == null)
    {
        <!-- ✅ SPINNER: Mientras el MainLayout obtiene los datos del usuario -->
        <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 100px 20px; width: 100%;">
            <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Style="width: 50px; height: 50px;" />
            <RadzenText TextStyle="TextStyle.Body1" Style="margin-top: 15px; color: #6c757d;">
                Cargando tu perfil...
            </RadzenText>
        </div>
    }
    else if (AppState.CurrentUser.Role == "Administrador")
    {
        <!-- ✅ SI ES ADMIN -->
        <DashboardAdmin />
    }
    else
    {
        <!-- ✅ SI ES RESIDENTE -->
        <DashboardUsuario />
    }
</div>


