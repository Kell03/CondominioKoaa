@page "/recibos"
@attribute [Authorize]
@using Condominio.Application.Services
@using Condominio.Domain.Entities
@using Condominio.Domain.Interfaces.Repositories
@using Condominio.Infrastructure.Repositories
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject FacturaMesCasaRepository FacturaMesCasaRepository
@inject FacturaMesRepository FacturaMesRepository
@inject IGenericRepository<Houses> HousesRepository
@using Radzen.Blazor
@inject Radzen.DialogService DialogService
@inject AuthenticationStateProvider AuthProvider
@inject AppState AppState
@inject MonedaApiService MonedaApiService
@rendermode InteractiveServer


<h3>Recibos</h3>



<RadzenTabs @bind-SelectedIndex=@selectedIndex>
    <Tabs>
        <RadzenTabsItem Text="Lista">


         

            @if (items == null)
            {
                <p>Cargando Recibos...</p>
            }
            else if (!items.Any())
            {
                <p>No hay recibos registrados.</p>
            }
            else
            {
                <RadzenButton Text="Agregar"
                              Icon="add_circle"
                              ButtonStyle="ButtonStyle.Primary"
                              Style="margin-bottom: 0.5rem;"
                              Click="@(() => CreateNewItem())"
                              Visible="@isAdmin" />


                
                <RadzenDataGrid @ref="grid" AllowFiltering="true" AllowPaging="true" PageSize="10" AllowSorting="true" RowRender="@RowRender" ExpandMode="DataGridExpandMode.Single"
                                Data="@items" TItem="FacturaMesCasa" RowExpand="RowExpand" ColumnWidth="300px" LogicalFilterOperator="LogicalFilterOperator.Or" SelectionMode="DataGridSelectionMode.Single" @bind-Value=@selectedEmployees
                                RowSelect="@((FacturaMesCasa item) => EditUser(item))">
                    <Template Context="order">
                        <RadzenCard Style="background:#dce3ea; padding: 15px; border-radius: 8px; margin: 5px 0;">

                            <RadzenText TextStyle="TextStyle.H6" Style="margin: 10px 0; color: #666;">
                                Detalle de Factura #@order.FacturaMes.Id
                            </RadzenText>
                            <RadzenDataGrid AllowFiltering="true" AllowPaging="true" AllowSorting="true" Style="background: #b8c6d9; border-radius: 6px;" Data="@order.FacturaMes.FacturaMesHijos">
                                <Columns>
                                    <RadzenDataGridColumn Property="FacturaMesCasa.FacturaMes.FacturaMesHijos.Motivo" Title="Motivo" />
                                    <RadzenDataGridColumn TItem="FacturaMesHijo" Title="Monto" Width="120px">
                                        <Template Context="item">
                                            @($"{item.Monto} $")
                                        </Template>
                                    </RadzenDataGridColumn>

                                </Columns>
                            </RadzenDataGrid>
                            <RadzenText TextStyle="TextStyle.Body1" Style="margin-top: 10px; font-weight: bold; text-align: right; color: #333; border-top: 1px solid #ddd; padding-top: 8px;">
                                Total: @order.FacturaMes.FacturaMesHijos.Sum(h => h.Monto) $
                            </RadzenText>
                        </RadzenCard>

                    </Template>
                    <Columns>

                    
                        <RadzenDataGridColumn TItem="FacturaMesCasa" Property="House.Number" Title="Nro Casa" Width="160px">
                            <Template Context="FacturaMesCasa">
                                @FacturaMesCasa.House.Number
                            </Template>
                        </RadzenDataGridColumn>


                        
                        <RadzenDataGridColumn TItem="FacturaMesCasa"
                                              Title="Propietario"
                                              Width="160px"
                                              Property="User.Name"
                                              Visible="@isAdmin">
                            <Template Context="facturaCasa">
                                @facturaCasa.User?.Name
                            </Template>
                        </RadzenDataGridColumn>


                        
                        <RadzenDataGridColumn TItem="FacturaMesCasa" Title="Referencia" Width="140px">
                            <Template Context="facturaCasa">
                                @facturaCasa.Referencia
                            </Template>
                        </RadzenDataGridColumn>
                       
                        <RadzenDataGridColumn TItem="FacturaMesCasa"
                                              Property="@nameof(FacturaMesCasa.MontoTotal)"
                                              Title="Monto"
                                              Width="auto">
                            <Template Context="facturaCasa">
                                @facturaCasa.MontoTotal $
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="FacturaMesCasa"
                                              Property="@nameof(FacturaMesCasa.NombreMes)"
                                              Title="Mes"
                                              Width="auto">
                            <Template Context="facturaCasa">
                                @facturaCasa.NombreMes
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="FacturaMesCasa"
                                              Property="@nameof(FacturaMesCasa.FacturaMes.Year)"
                                              Title="Año"
                                              Width="auto">
                            <Template Context="facturaCasa">
                                @facturaCasa.FacturaMes.Year
                            </Template>
                        </RadzenDataGridColumn>

                    
                        <RadzenDataGridColumn TItem="FacturaMesCasa"
                                              Property="Estado"
                                              Title="Estado"
                                              Width="140px">
                            <Template Context="facturaCasa">
                                @if (facturaCasa.Estado == "Pendiente")
                                {
                                    <RadzenBadge Style="background: #ffc107; color: #000; padding: 4px 8px; border-radius: 4px;">
                                        Pendiente
                                    </RadzenBadge>
                                }
                                else if (facturaCasa.Estado == "En Revision")
                                {
                                    <RadzenBadge Style="background: #6c757d; color: #fff; padding: 4px 8px; border-radius: 4px;">
                                        En Revision
                                    </RadzenBadge>
                                }
                                else if (facturaCasa.Estado == "Confirmada")
                                {
                                    <RadzenBadge Style="background: #28a745; color: #fff; padding: 4px 8px; border-radius: 4px;">
                                        Confirmada
                                    </RadzenBadge>
                                }
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="FacturaMesCasa" Title="Opciones" Width="120px" TextAlign="TextAlign.Center" Visible="@isAdmin">
                            <Template Context="factura">


                                @if (factura.Estado != "Confirmada")
                                {

                                
                                    <RadzenButton Icon="check_circle"
                                                  ButtonStyle="ButtonStyle.Success"
                                                  Size="ButtonSize.Small"
                                                  Tooltip="Confirmar pago"
                                                  Click="@(() => ConfirmSend(factura, confirmar:true))"
                                                  @onclick:stopPropagation="true" />

                                    <!-- ✅ BOTÓN RECHAZAR -->
                                    <RadzenButton Icon="cancel"
                                                  ButtonStyle="ButtonStyle.Danger"
                                                  Size="ButtonSize.Small"
                                                  Tooltip="Rechazar pago"
                                                  Click="@(() => ConfirmSend(factura, confirmar:false))"
                                                  @onclick:stopPropagation="true" />
                                }
                                else
                                {
                                    <RadzenButton Text="Confirmado"
                                                  Style="background: #6c757d;"
                                                  Size="ButtonSize.Small"
                                                  Disabled="true"
                                                  Tooltip="Confirmar pago"
                                                  @onclick:stopPropagation="true" />
                                }



                            </Template>
                        </RadzenDataGridColumn>

                        
                    
                    </Columns>
                </RadzenDataGrid>





             

            }
        </RadzenTabsItem>
        <RadzenTabsItem Text="Formulario" Disabled="true">

            
            <RadzenTemplateForm Data=@selectedItem class="rz-p-0 rz-p-md-12" @onsubmit="SaveItem">
                <RadzenStack Gap="1.5rem">


                    <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                        <RadzenLabel Component="MesAnioLabel">
                            Mes/Año <span style="color: var(--rz-danger);">*</span>
                        </RadzenLabel>
                        <RadzenText TextStyle="TextStyle.Body1"
                                    Style="padding: 8px 12px; background: #f5f5f5; border-radius: 4px; border: 1px solid #ddd; width: 100%; max-width: 400px;  cursor: default;">
                            @selectedItem.NombreMes @selectedItem.Year
                        </RadzenText>
                    </RadzenStack>

                    <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                        <RadzenLabel Component="NumberRequiredInput">
                            Numero Casa
                        </RadzenLabel>
                        <RadzenText TextStyle="TextStyle.Body1"
                                    Style="padding: 8px 12px; background: #f5f5f5; border-radius: 4px; border: 1px solid #ddd; width: 100%; max-width: 400px;  cursor: default;">
                            @selectedItem.House.Number
                        </RadzenText>
                    </RadzenStack>



                    
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                        <RadzenLabel Component="MontoTotalLabel">
                            Monto Total <span style="color: var(--rz-danger);">*</span>
                        </RadzenLabel>

                        @if (isAdmin)
                        {
                            <RadzenNumeric @bind-Value="@selectedItem.MontoTotal"
                                           Style="width: 100%; max-width: 400px;"
                                           Format="N2"
                                           Min="0"
                                           Step="0.01" />
                        }
                        else
                        {

                          

                            <RadzenNumeric @bind-Value="@selectedItem.MontoTotal"
                                           Style="padding: 8px 12px; background: #f5f5f5; border-radius: 4px; border: 1px solid #ddd; width: 100%; max-width: 400px;  cursor: default;"
                                           Format="N2"
                                           Min="0"
                                           ReadOnly=" true"
                                           Step="0.01" />

                        }

                    </RadzenStack>


                   
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                        <RadzenLabel Component="NumberRequiredInput">
                            Monto Bs
                        </RadzenLabel>
                        @if (isAdmin)
                        {
                            <RadzenNumeric @bind-Value="@selectedItem.MontoBs"
                                           Style="width: 100%; max-width: 400px;"
                                           Format="N2"
                                           Min="0"
                                           Step="0.01" />
                        }
                        else
                        {

                            <RadzenNumeric @bind-Value="@selectedItem.MontoBs"
                                           Style="padding: 8px 12px; background: #f5f5f5; border-radius: 4px; border: 1px solid #ddd; width: 100%; max-width: 400px;  cursor: default;"
                                           Format="N2"
                                           Min="0"
                                           ReadOnly=" true"
                                           Step="0.01" />

                        }
                    </RadzenStack>

            
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                        <RadzenLabel Component="MPRequiredInput">
                            Metodo de Pago <span style="color: var(--rz-danger);">*</span>
                        </RadzenLabel>

                        <RadzenDropDown @bind-Value="@selectedItem.MetodoPago"
                                        Data="@MetodosPago"
                                        Style="width: 100%; max-width: 400px;"
                                        Name="MPRequiredInput" />

                        <RadzenRequiredValidator Component="MPRequiredInput" Text="El método de pago es requerido" />
                    </RadzenStack>


                    <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                        <RadzenLabel Component="NumeroReferenciaRequiredInput">
                            Numero Referencia <span style="color: var(--rz-danger);">*</span>
                        </RadzenLabel>
                        <RadzenTextBox Name="NumeroReferenciaRequiredInput" @bind-Value=@selectedItem.Referencia Style="width: 100%; max-width: 400px;" />
                        <RadzenRequiredValidator Component="NumeroReferenciaRequiredInput" Text="Referencia is required" />
                    </RadzenStack>


                    <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                        <RadzenLabel Text="Fecha Pago" Component="RadzenDatePickerBindValue" />
                        <RadzenDatePicker @bind-Value=@selectedItem.FechaPago Name="RadzenDatePickerBindValue" ShowCalendarWeek Style="width: 100%; max-width: 400px;" />
                    </RadzenStack>

 
                    <RadzenButton ButtonType="ButtonType.Submit" Text="Submit Form" Style="width: 100%; max-width: 400px;" />


                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenTabsItem>

        <RadzenTabsItem Text="Nuevo" Disabled="true" Visible="@isAdmin">
            <RadzenTemplateForm Data=@selectedItem class="rz-p-0 rz-p-md-12" @onsubmit="SaveNewItem">
                <RadzenStack Gap="1.5rem">


                    <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                        <RadzenLabel Text="Seleccionar Cuota" Component="DropDownFiltering" />
                        <RadzenDropDown TValue="int"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        FilterOperator="StringFilterOperator.StartsWith"
                                        AllowFiltering="true"
                                        Data="@FacturasMes"
                                        ValueProperty="@nameof(FacturaMes.Id)"
                                        AllowClear="true"
                                        @bind-Value="@selectedItem.FacturaMesId"
                                        Style="width: 100%; max-width: 400px;"
                                        Name="DropDownFiltering">
                            <Template Context="item">
                               @item.NombreMes @item.Year
                            </Template>
                        </RadzenDropDown>
                    </RadzenStack>

                    <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                        <RadzenLabel Text="Seleccionar Casa" Component="DropDownFiltering" />
                        <RadzenDropDown TValue="int" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterOperator="StringFilterOperator.StartsWith" AllowFiltering="true"
                                        Data=@HouseList TextProperty="@nameof(Houses.Number)" ValueProperty="@nameof(Houses.Id)" AllowClear="true" @bind-Value=selectedItem.HouseId Style="width: 100%; max-width: 400px;" Name="DropDownFiltering" />
                    </RadzenStack>



                    <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                        <RadzenLabel Component="NumberRequiredInput">
                            Monto Usd
                        </RadzenLabel>
                        <RadzenNumeric @bind-Value="@selectedItem.MontoTotal"
                                       Style="width: 100%; max-width: 400px;"
                                       Format="N2"
                                       Min="0"
                                       Step="0.01" />
                    </RadzenStack>

         
 
                    <RadzenButton ButtonType="ButtonType.Submit" Text="Submit Form" Style="width: 100%; max-width: 400px;" />


                </RadzenStack>
            </RadzenTemplateForm>

        </RadzenTabsItem>
    </Tabs>
</RadzenTabs>

@code {
    int selectedIndex = 0;

    

    
}
