@page "/recibos"
@attribute [Authorize]
@using Condominio.Application.Services
@using Condominio.Domain.Entities
@using Condominio.Domain.Interfaces.Repositories
@using Condominio.Infrastructure.Repositories
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject FacturaMesCasaRepository FacturaMesCasaRepository
@inject FacturaMesRepository FacturaMesRepository
@inject IGenericRepository<Houses> HousesRepository
@using Radzen.Blazor
@inject Radzen.DialogService DialogService
@inject AuthenticationStateProvider AuthProvider
@inject AppState AppState
@inject BcvScraperService BcvScraper
@rendermode InteractiveServer


<h3>Recibos</h3>



<RadzenTabs @bind-SelectedIndex=@selectedIndex>
    <Tabs>
        <RadzenTabsItem Text="Lista">



                
            <RadzenDataGrid @ref="grid" AllowFiltering="true" AllowPaging="true" PageSize="10" AllowSorting="true" RowRender="@RowRender" ExpandMode="DataGridExpandMode.Single"
                            Data="@items" TItem="FacturaMesCasa" RowExpand="RowExpand" ColumnWidth="300px" LogicalFilterOperator="LogicalFilterOperator.Or" SelectionMode="DataGridSelectionMode.Single" @bind-Value=@selectedEmployees>
                <Template Context="order">
                    <RadzenCard Style="background:#dce3ea; padding: 15px; border-radius: 8px; margin: 5px 0;">

                        <RadzenText TextStyle="TextStyle.H6" Style="margin: 10px 0; color: #666;">
                            Detalle de Factura #@order.FacturaMes.Id
                        </RadzenText>
                        <RadzenDataGrid AllowFiltering="true" AllowPaging="true" AllowSorting="true" Style="background: #b8c6d9; border-radius: 6px;" Data="@order.FacturaMes.FacturaMesHijos">
                            <Columns>
                                <RadzenDataGridColumn Property="FacturaMesCasa.FacturaMes.FacturaMesHijos.Motivo" Title="Motivo" />
                                <RadzenDataGridColumn TItem="FacturaMesHijo" Title="Monto" Width="120px">
                                    <Template Context="item">
                                        @($"{item.Monto} $")
                                    </Template>
                                </RadzenDataGridColumn>

                            </Columns>
                        </RadzenDataGrid>
                        <RadzenText TextStyle="TextStyle.Body1" Style="margin-top: 10px; font-weight: bold; text-align: right; color: #333; border-top: 1px solid #ddd; padding-top: 8px;">
                            Total: @order.FacturaMes.FacturaMesHijos.Sum(h => h.Monto) $
                        </RadzenText>
                    </RadzenCard>

                </Template>
                <Columns>

                    
                    <RadzenDataGridColumn TItem="FacturaMesCasa" Property="House.Number" Title="Nro Casa" Width="160px">
                        <Template Context="FacturaMesCasa">
                            @FacturaMesCasa.House.Number
                        </Template>
                    </RadzenDataGridColumn>


                        
                    <RadzenDataGridColumn TItem="FacturaMesCasa"
                                          Title="Propietario"
                                          Width="160px"
                                          Property="User.Name"
                                          Visible="@isAdmin">
                        <Template Context="facturaCasa">
                            @facturaCasa.User?.Name
                        </Template>
                    </RadzenDataGridColumn>


                        
     
                       
                    <RadzenDataGridColumn TItem="FacturaMesCasa"
                                          Property="@nameof(FacturaMesCasa.MontoTotal)"
                                          Title="Monto"
                                          Width="120px">
                        <Template Context="facturaCasa">
                            @facturaCasa.MontoTotal $
                        </Template>
                    </RadzenDataGridColumn>


                    <RadzenDataGridColumn TItem="FacturaMesCasa"
                                          Property="@nameof(FacturaMesCasa.MontoPagado)"
                                          Title="Pagado"
                                          Width="140px">
                        <Template Context="facturaCasa">
                            @facturaCasa.MontoPagado $
                        </Template>
                    </RadzenDataGridColumn>


                    <RadzenDataGridColumn TItem="FacturaMesCasa"
                                          Property="@nameof(FacturaMesCasa.SaldoPendiente)"
                                          Title="Pendiente"
                                          Width="140px">
                        <Template Context="facturaCasa">
                            @facturaCasa.SaldoPendiente $
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="FacturaMesCasa"
                                          Property="@nameof(FacturaMesCasa.NombreMes)"
                                          Title="Mes"
                                          Width="auto">
                        <Template Context="facturaCasa">
                            @facturaCasa.NombreMes
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="FacturaMesCasa"
                                          Property="@nameof(FacturaMesCasa.FacturaMes.Year)"
                                          Title="Año"
                                          Width="auto">
                        <Template Context="facturaCasa">
                            @facturaCasa.FacturaMes.Year
                        </Template>
                    </RadzenDataGridColumn>

                    
                    <RadzenDataGridColumn TItem="FacturaMesCasa"
                                          Property="Estado"
                                          Title="Estado"
                                          Width="140px">
                        <Template Context="facturaCasa">
                            @if (facturaCasa.Estado == "Pendiente")
                            {
                                <span style="background: #f8d7da; color: #721c24; padding: 2px 10px; border-radius: 4px; font-size: 12px; font-weight: 500; display: inline-block;">
                                    Pendiente
                                </span>
                            }
                            else if (facturaCasa.Estado == "Pago Parcial")
                            {
                                <span style="background: #e9ecef; color: #6c757d; padding: 2px 10px; border-radius: 4px; font-size: 12px; font-weight: 500; display: inline-block;">
                                    En Revisión
                                </span>
                            }
                            else if (facturaCasa.Estado == "Confirmada")
                            {
                                <span style="background: #d4edda; color: #155724; padding: 2px 10px; border-radius: 4px; font-size: 12px; font-weight: 500; display: inline-block;">
                                    Confirmada
                                </span>
                            }
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="FacturaMesCasa" Title="Opciones" Width="120px" TextAlign="TextAlign.Center">
                        <Template Context="factura">


                            @if (factura.SaldoPendiente <= 0)
                            {
                                <RadzenButton Text="Ver"
                                              Icon="visibility"
                                              ButtonStyle="ButtonStyle.Success"
                                              Size="ButtonSize.Small"
                                              Tooltip="Ver pago"
                                              Click="@(() => EditUser(factura))"
                                              @onclick:stopPropagation="true"
                                              Visible="@(!isAdmin)" />
                            }
                            else
                            {

                                <RadzenButton Text="Pagar"
                                              Icon="payment"
                                              ButtonStyle="ButtonStyle.Secondary"
                                              Size="ButtonSize.Small"
                                              Tooltip="Realizar pago"
                                              Click="@(() => EditUser(factura))"
                                              @onclick:stopPropagation="true"
                                              Visible="@(!isAdmin)" />

                            }

                            
                            <RadzenButton Icon="visibility"
                                          ButtonStyle="ButtonStyle.Secondary"
                                          Size="ButtonSize.Small"
                                          Tooltip="Ver detalles"
                                          Click="@(() => AddPagosList(factura))"
                                          @onclick:stopPropagation="true"
                                          Visible="@isAdmin" />

                            
                        </Template>
                    </RadzenDataGridColumn>

                        
                    
                </Columns>

                <EmptyTemplate>
                    <div style="padding: 20px; text-align: center; color: #6c757d;">
                        <RadzenIcon Icon="info" Style="font-size: 48px; color: #ccc;" />
                        <RadzenText TextStyle="TextStyle.H5" Style="margin-top: 10px;">
                            No hay Facturas registrados
                        </RadzenText>

                    </div>
                </EmptyTemplate>
            </RadzenDataGrid>





             

            
        </RadzenTabsItem>
        <RadzenTabsItem Text="Formulario" Disabled="true">

            @if (selectedItem.SaldoPendiente > 0)
            {
                <!-- ✅ CARD 1: INFORMACIÓN DE PAGO MÓVIL -->
                <RadzenCard Style="background: #f8f9fa; border-left: 4px solid #17a2b8; margin-bottom: 15px; padding: 15px;">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0.3rem">
                        <RadzenText TextStyle="TextStyle.Body2" Style="color: #6c757d; font-weight: 500;">
                             Pago Móvil
                        </RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2" Style="color: #495057; margin: 0;">
                            <strong>C.I:</strong> xx.xxx.xxx
                        </RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2" Style="color: #495057; margin: 0;">
                            <strong>Teléfono:</strong> xxxx-xxx.xx.xx
                        </RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2" Style="color: #495057; margin: 0;">
                            <strong>Banco:</strong> Banco de Venezuela
                        </RadzenText>
                    </RadzenStack>
                </RadzenCard>

                <!-- ✅ CARD 2: SALDO PENDIENTE -->
                <RadzenCard Style="background: #f8f9fa; border-left: 4px solid #6c757d; margin-bottom: 10px; padding: 15px;">
                    <RadzenRow Gap="0.5rem">
                        <!-- TÍTULO -->
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenText TextStyle="TextStyle.H5" Style="color: #495057; margin: 0; font-size: clamp(16px, 2vw, 24px);">
                                Saldo Pendiente
                            </RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2" Style="color: #6c757d; margin: 0; font-size: clamp(12px, 1.5vw, 14px);">
                                Monto restante por pagar
                            </RadzenText>
                        </RadzenColumn>

                        <!-- MONTO -->
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack Orientation="Orientation.Horizontal"
                                         AlignItems="AlignItems.Center"
                                         Style="width: 100%;">
                                <RadzenText TextStyle="TextStyle.H2"
                                            Style="color: #495057; font-weight: bold; margin: 0; font-size: clamp(24px, 3vw, 32px);">
                                    @selectedItem.SaldoPendiente.ToString("N2") $
                                </RadzenText>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenCard>


                <RadzenTemplateForm Data=@selectedItem style="margin-bottom:10px" @onsubmit="SavePago">
                    <RadzenStack Gap="1rem">

                        <RadzenRow  Gap="1rem">

                            <RadzenColumn Size="12" SizeSM="6">
                                <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                                    <RadzenLabel Component="MPRequiredInput">
                                        Metodo de Pago <span style="color: var(--rz-danger);">*</span>
                                    </RadzenLabel>

                                    <RadzenDropDown @bind-Value="@Pago.MetodoPago"
                                                    Data="@MetodosPago"
                                                    Style="width: 100%;"
                                                    Name="MPRequiredInput" />

                                    <RadzenRequiredValidator Component="MPRequiredInput" Text="El método de pago es requerido" />
                                </RadzenStack>
                            </RadzenColumn>

                            <RadzenColumn Size="12" SizeSM="6">
                                <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                                    <RadzenLabel Component="MontoTotalLabel">
                                        Tasa
                                    </RadzenLabel>

                                    <div style="display: flex; align-items: center; gap: 8px;">
                                        <RadzenText TextStyle="TextStyle.Body1"
                                                    Style="padding: 8px 12px; background: #f5f5f5; border-radius: 4px; border: 1px solid #ddd; width: 100%; cursor: default;">
                                            @Pago.Tasa?.ToString() Bs
                                        </RadzenText>
                                    </div>
                                </RadzenStack>
                            </RadzenColumn>


                            <RadzenColumn Size="12" SizeSM="6">
                                <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                                    <RadzenLabel Component="MontoTotalLabel">
                                        Monto Total <span style="color: var(--rz-danger);">*</span>
                                    </RadzenLabel>

                                    <RadzenNumeric Value="@Pago.Monto"
                                                   ValueChanged="@((decimal? value) => OnMontoChanged(value))"
                                                   Style="width: 100%;"
                                                   Format="N2"
                                                   Min="0"
                                                   Step="0.01" />
                                </RadzenStack>
                            </RadzenColumn>

                            <RadzenColumn Size="12" SizeSM="6">
                                <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                                    <RadzenLabel Component="MontoTotalLabel">
                                        Monto Total Bs <span style="color: var(--rz-danger);">*</span>
                                    </RadzenLabel>

                                    <RadzenNumeric @bind-Value="@Pago.MontoBs"
                                                   Style="width: 100%;"
                                                   Format="N2"
                                                   Min="0"
                                                   Step="0.01"
                                                   ReadOnly="true" />  <!-- ✅ SOLO LECTURA -->
                                </RadzenStack>
                            </RadzenColumn>


                        



                            <RadzenColumn Size="12" SizeSM="6">
                                <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                                    <RadzenLabel Component="NameRequiredInput">
                                        Referencia
                                    </RadzenLabel>
                                    <RadzenTextBox Name="NameRequiredInput"
                                                   @bind-Value="@Pago.Referencia"
                                                   Style="width: 100%;" />
                                </RadzenStack>
                            </RadzenColumn>



                            <RadzenColumn Size="12" SizeSM="6">

                            
                                <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                                    <RadzenLabel Text="Fecha Pago" Component="RadzenDatePickerBindValue" />
                                    <RadzenDatePicker @bind-Value="@Pago.FechaPago"
                                                      Name="RadzenDatePickerBindValue"
                                                      ShowCalendarWeek="true"
                                                      DateFormat="yyyy-MM-dd"
                                                      ShowTime="false"
                                                      Style="width: 100%;" />
                                </RadzenStack>

                            </RadzenColumn>



                            <RadzenColumn Size="12" SizeSM="12">

                                <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                                    <RadzenLabel Component="NameRequiredInput">
                                        Comentario
                                    </RadzenLabel>
                                    <RadzenTextBox Name="NameRequiredInput" @bind-Value=@Pago.Comentario Style="width: 100%; " />
                                </RadzenStack>


                            </RadzenColumn>
                        </RadzenRow>


                        <!-- ✅ BOTÓN GUARDAR -->
                        <RadzenStack Orientation="Orientation.Horizontal"
                                     JustifyContent="JustifyContent.Center"
                                     Gap="1rem"
                                     Style="flex-wrap: wrap;">
                            <RadzenButton ButtonType="ButtonType.Submit"
                                          Text="Guardar"
                                          Icon="save"
                                          ButtonStyle="ButtonStyle.Success"
                                          Style="width: 100%; max-width: 400px;" />
                            <RadzenButton Text="Cancelar"
                                          Icon="cancel"
                                          ButtonStyle="ButtonStyle.Secondary"
                                          Click="@(() => selectedIndex = 0)"
                                          Style="width: 100%; max-width: 200px;" />
                        </RadzenStack>

                    </RadzenStack>
                </RadzenTemplateForm>
            }

           



            <RadzenDataGrid AllowFiltering="true" AllowColumnResize="true" AllowAlternatingRows="false" FilterMode="FilterMode.Advanced" AllowSorting="true" PageSize="5" AllowPaging="true" PagerHorizontalAlign="HorizontalAlign.Left" ShowPagingSummary="true"
                            Data="@PagosList" ColumnWidth="300px" LogicalFilterOperator="LogicalFilterOperator.Or" SelectionMode="DataGridSelectionMode.Single">
                <Columns>
                    <RadzenDataGridColumn Property="@nameof(Payments.Referencia)" Filterable="false" Title="Referencia" Width="120px" TextAlign="TextAlign.Center" />


                    <RadzenDataGridColumn TItem="Payments"
                                          Property="@nameof(Payments.Monto)"
                                          Title="Monto"
                                          Width="100px">
                        <Template Context="pago">
                            @pago.Monto $
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="Payments"
                                          Property="@nameof(Payments.MontoBs)"
                                          Title="Monto Bs"
                                          Width="120px">
                        <Template Context="pago">
                            @pago.MontoBs Bs
                        </Template>
                    </RadzenDataGridColumn>


                    <RadzenDataGridColumn TItem="Payments"
                                          Property="@nameof(Payments.Tasa)"
                                          Title="Tasa"
                                          Width="100px">
                        <Template Context="pago">
                            @pago.Tasa Bs
                        </Template>
                    </RadzenDataGridColumn>

                                       

                    <RadzenDataGridColumn TItem="Payments" Title="Fecha" Width="100px">
                        <Template Context="payment">
                            @payment.FechaPago.ToString("dd/MM/yyyy")
                        </Template>
                    </RadzenDataGridColumn>

                </Columns>
            </RadzenDataGrid>

        </RadzenTabsItem>

       
    </Tabs>
</RadzenTabs>

@code {
    int selectedIndex = 0;

    

    
}
