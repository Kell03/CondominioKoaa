@page "/login"
@layout EmptyLayout
@using Condominio.Application.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthService AuthService
@inject NavigationManager NavigationManager
@inject Radzen.NotificationService NotificationService
@inject AppState AppState
@rendermode InteractiveServer
@inject HttpClient Http   // ← Esto inyecta un HttpClient, y se llama "Http"
@inject AuthenticationStateProvider AuthProvider

<RadzenCard Style="max-width: 400px; margin: 50px auto;">

    <!-- ✅ LOGO CENTRADO -->
    <!-- ✅ Contenedor que recorta el espacio vacío de la imagen -->
    <div style="text-align: center; margin-bottom: 20px; height: 45px; overflow: hidden; display: flex; justify-content: center; align-items: center;">
        <img src="/SOLUNARINF.png"
             alt="Logo"
             style="height: 180px; width: auto; margin-top: -25px; margin-bottom: -20px;" />
    </div>
    <hr style="margin: 0 0 10px 0; border: 0; border-top: 1px solid #ced4da; width: 100%;" />


    <RadzenStack Gap="1rem">
        <!-- ✅ EMAIL -->
        <RadzenStack Orientation="Orientation.Vertical" Gap="0.3rem">
            <RadzenLabel Text="Email" />
            <RadzenTextBox @bind-Value="@email" />
        </RadzenStack>

        <!-- ✅ CONTRASEÑA (CON RadzenTextBox + Type Password) -->
        <RadzenStack Orientation="Orientation.Vertical" Gap="0.3rem">
            <RadzenLabel Text="Contraseña" />
            <RadzenPassword Name="PasswordRequiredInput" @bind-Value=@password aria-label="enter password" />
        </RadzenStack>



        <!-- ✅ BOTÓN LOGIN -->
        <RadzenButton Text="Ingresar"
                      Icon="login"
                      ButtonStyle="ButtonStyle.Primary"
                      Click="@Login"
                      IsLoading="@isLoading" />

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <RadzenText Style="color: red;">@errorMessage</RadzenText>
        }
    </RadzenStack>
</RadzenCard>