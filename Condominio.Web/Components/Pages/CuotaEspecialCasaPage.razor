@page "/cuotaespecialcasa"
@attribute [Authorize]
@using Condominio.Application.Services
@using Condominio.Domain.Entities
@using Condominio.Domain.Interfaces.Repositories
@using Condominio.Infrastructure.Repositories
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject CuotaEspecialCasaRepository CuotaEspecialCasaRepository
@inject CuotaEspecialRepository CuotaEspecialRepository
@inject IGenericRepository<Houses> HousesRepository
@using Radzen.Blazor
@inject Radzen.DialogService DialogService
@inject AuthenticationStateProvider AuthProvider
@inject AppState AppState
@inject BcvScraperService BcvScraper
@rendermode InteractiveServer

<RadzenTabs @bind-SelectedIndex=@selectedIndex>
    <Tabs>
        <RadzenTabsItem Text="Lista">


            <RadzenButton Text="Agregar"
                          Icon="add_circle"
                          ButtonStyle="ButtonStyle.Primary"
                          Style="margin-bottom: 0.5rem;"
                          Click="@(() => CreateNewItem())"
                          Visible="@isAdmin" />

         

            <RadzenDataGrid AllowFiltering="true" AllowColumnResize="true" AllowAlternatingRows="false" FilterMode="FilterMode.Advanced" AllowSorting="true" PageSize="5" AllowPaging="true" PagerHorizontalAlign="HorizontalAlign.Left" ShowPagingSummary="true"
                            Data="@items" ColumnWidth="300px" LogicalFilterOperator="LogicalFilterOperator.Or" SelectionMode="DataGridSelectionMode.Single" @bind-Value=@selectedEmployees>
                <Columns>

                    <RadzenDataGridColumn TItem="CuotaEspecialCasa" Title="Casa" Width="120px">
                        <Template Context="cuota">
                            @cuota.House.Number
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="CuotaEspecialCasa"
                                          Title="Propietario"
                                          Width="130px"
                                          Property="User.Name"
                                          Visible="@isAdmin">
                        <Template Context="cuotaCasa">
                            @cuotaCasa.User?.Name
                        </Template>
                    </RadzenDataGridColumn>


                    <RadzenDataGridColumn TItem="CuotaEspecialCasa" Title="Motivo" Width="150px">
                        <Template Context="cuota">
                            @cuota.CuotaEspecial?.Motivo
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="CuotaEspecialCasa" Title="Monto" Width="120px">
                        <Template Context="cuota">
                            @cuota.MontoTotal $
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="CuotaEspecialCasa" Title="Pagado" Width="120px">
                        <Template Context="cuota">
                            @cuota.MontoPagado $
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="CuotaEspecialCasa" Title="Pendiente" Width="120px">
                        <Template Context="cuota">
                            @cuota.SaldoPendiente $
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="CuotaEspecialCasa" Title="Mes" Width="140px">
                        <Template Context="cuota">
                            @cuota.CuotaEspecial.NombreMes
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="CuotaEspecialCasa" Title="Año" Width="140px">
                        <Template Context="cuota">
                            @cuota.CuotaEspecial.Year
                        </Template>
                    </RadzenDataGridColumn>

                      
                    <RadzenDataGridColumn TItem="CuotaEspecialCasa"
                                          Property="Estado"
                                          Title="Estado"
                                          Width="140px">
                        <Template Context="cuotaCasa">
                            @if (cuotaCasa.Estado == "Pendiente")
                            {
                                <span style="background: #f8d7da; color: #721c24; padding: 2px 10px; border-radius: 4px; font-size: 12px; font-weight: 500; display: inline-block;">
                                    Pendiente
                                </span>
                            }
                            else if (cuotaCasa.Estado == "Pago Parcial")
                            {
                                <span style="background: #e9ecef; color: #6c757d; padding: 2px 10px; border-radius: 4px; font-size: 12px; font-weight: 500; display: inline-block;">
                                    En Revisión
                                </span>
                            }
                            else if (cuotaCasa.Estado == "Confirmada")
                            {
                                <span style="background: #d4edda; color: #155724; padding: 2px 10px; border-radius: 4px; font-size: 12px; font-weight: 500; display: inline-block;">
                                    Confirmada
                                </span>
                            }
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="CuotaEspecialCasa" Title="Opciones" Width="120px" TextAlign="TextAlign.Center">
                        <Template Context="cuotaCasa">


                            @if (cuotaCasa.SaldoPendiente <= 0)
                            {
                                <RadzenButton Text="Ver"
                                              Icon="visibility"
                                              ButtonStyle="ButtonStyle.Success"
                                              Size="ButtonSize.Small"
                                              Tooltip="Ver pago"
                                              Click="@(() => EditUser(cuotaCasa))"
                                              @onclick:stopPropagation="true"
                                              Visible="@(!isAdmin)" />
                            }
                            else
                            {

                                <RadzenButton Text="Pagar"
                                              Icon="payment"
                                              ButtonStyle="ButtonStyle.Secondary"
                                              Size="ButtonSize.Small"
                                              Tooltip="Realizar pago"
                                              Click="@(() => EditUser(cuotaCasa))"
                                              @onclick:stopPropagation="true"
                                              Visible="@(!isAdmin)" />

                            }

                            <RadzenButton Icon="visibility"
                                          ButtonStyle="ButtonStyle.Secondary"
                                          Size="ButtonSize.Small"
                                          Tooltip="Ver detalles"
                                          Click="@(() => AddPagosList(cuotaCasa))"
                                          @onclick:stopPropagation="true"
                                          Visible="@isAdmin" />


                        </Template>
                    </RadzenDataGridColumn>

                   

                </Columns>




                <EmptyTemplate>
                    <div style="padding: 20px; text-align: center; color: #6c757d;">
                        <RadzenIcon Icon="info" Style="font-size: 48px; color: #ccc;" />
                        <RadzenText TextStyle="TextStyle.H5" Style="margin-top: 10px;">
                            No hay Cuotas registradas
                        </RadzenText>

                    </div>
                </EmptyTemplate>
            </RadzenDataGrid>


            
        </RadzenTabsItem>
        <RadzenTabsItem Text="Formulario" Disabled="true">

            @if (selectedItem.SaldoPendiente > 0)
            {

                <!-- ✅ CARD 1: INFORMACIÓN DE PAGO MÓVIL -->
                <RadzenCard Style="background: #f8f9fa; border-left: 4px solid #17a2b8; margin-bottom: 15px; padding: 15px;">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0.3rem">
                        <RadzenText TextStyle="TextStyle.Body2" Style="color: #6c757d; font-weight: 500;">
                            Pago Móvil
                        </RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2" Style="color: #495057; margin: 0;">
                            <strong>C.I:</strong> xx.xxx.xxx
                        </RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2" Style="color: #495057; margin: 0;">
                            <strong>Teléfono:</strong> xxxx-xxx.xx.xx
                        </RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2" Style="color: #495057; margin: 0;">
                            <strong>Banco:</strong> Banco de Venezuela
                        </RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2" Style="color: #495057; margin: 0;">
                            <strong>Tasa:</strong>   @Pago.Tasa?.ToString() Bs
                        </RadzenText>
                    </RadzenStack>
                </RadzenCard>

                <!-- ✅ CARD 2: SALDO PENDIENTE -->
                <RadzenCard Style="background: #f8f9fa; border-left: 4px solid #6c757d; margin-bottom: 10px; padding: 15px;">
                    <RadzenRow Gap="0.5rem">
                        <!-- TÍTULO -->
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenText TextStyle="TextStyle.H5" Style="color: #495057; margin: 0; font-size: clamp(16px, 2vw, 24px);">
                                Saldo Pendiente
                            </RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2" Style="color: #6c757d; margin: 0; font-size: clamp(12px, 1.5vw, 14px);">
                                Monto restante por pagar
                            </RadzenText>
                        </RadzenColumn>

                        <!-- MONTO -->
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack Orientation="Orientation.Horizontal"
                                         AlignItems="AlignItems.Center"
                                         Style="width: 100%;">
                                <RadzenText TextStyle="TextStyle.H2"
                                            Style="color: #495057; font-weight: bold; margin: 0; font-size: clamp(24px, 3vw, 32px);">
                                    @selectedItem.SaldoPendiente.ToString("N2") $
                                </RadzenText>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenCard>
                <RadzenTemplateForm TItem="Payments"
                                    Data="@Pago"
                                    Submit="@SavePago"
                                    style="margin-bottom:10px">

                    <RadzenStack Gap="1rem">

                        <RadzenRow Gap="1rem">

                            <!-- MÉTODO DE PAGO -->
                            <RadzenColumn Size="12" SizeSM="6">
                                <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                                    <RadzenLabel Component="MPRequiredInput">
                                        Metodo de Pago <span style="color: var(--rz-danger);">*</span>
                                    </RadzenLabel>
                                    <RadzenDropDown @bind-Value="@Pago.MetodoPago"
                                                    Data="@MetodosPago"
                                                    Style="width: 100%;"
                                                    Name="MPRequiredInput" />
                                    <RadzenRequiredValidator Component="MPRequiredInput" Text="El método de pago es requerido" />
                                </RadzenStack>
                            </RadzenColumn>

                            <!-- REFERENCIA -->
                            <RadzenColumn Size="12" SizeSM="6">
                                <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                                    <RadzenLabel Component="ReferenciaRequiredInput">
                                        Referencia <span style="color: var(--rz-danger);">*</span>
                                    </RadzenLabel>
                                    <RadzenTextBox Name="ReferenciaRequiredInput"
                                                   @bind-Value="@Pago.Referencia"
                                                   Style="width: 100%;" />
                                    <RadzenRequiredValidator Component="ReferenciaRequiredInput" Text="La referencia es requerida" />
                                </RadzenStack>
                            </RadzenColumn>


                            <!-- MONTO USD -->
                            <RadzenColumn Size="12" SizeSM="6">
                                <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                                    <RadzenLabel Component="MontoRequiredInput">
                                        Monto $ <span style="color: var(--rz-danger);">*</span>
                                    </RadzenLabel>

                                    <input type="text"
                                           value="@_montoUsdStr"
                                           @oninput="@((ChangeEventArgs e) => OnInputUsdChanged(e.Value?.ToString()))"
                                           onkeypress="return (event.charCode == 0 || (event.charCode >= 48 && event.charCode <= 57) || event.charCode == 44 || event.charCode == 46)"
                                           style="width: 100%; padding: 8px 12px; border: 1px solid #ddd; border-radius: 4px; font-size: 14px;"
                                           name="MontoRequiredUsdInput"
                                           placeholder="0,00"
                                           inputmode="decimal" />

                                    <RadzenNumeric @bind-Value="@Pago.Monto"
                                                   Style="display: none;"
                                                   Name="MontoRequiredInput" />

                                    <RadzenRequiredValidator Component="MontoRequiredInput" Text="El monto es requerido" />
                                    <RadzenNumericRangeValidator Min="0.01" Max="999999.99"
                                                                 Component="MontoRequiredInput"
                                                                 Text="El monto debe ser mayor a 0" />
                                </RadzenStack>
                            </RadzenColumn>

                            <!-- MONTO BS -->
                            <RadzenColumn Size="12" SizeSM="6">
                                <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                                    <RadzenLabel Component="MontoRequiredBsInput">
                                        Monto Bs <span style="color: var(--rz-danger);">*</span>
                                    </RadzenLabel>

                                    <input type="text"
                                           value="@_montoBsStr"
                                           @oninput="@((ChangeEventArgs e) => OnInputChanged(e.Value?.ToString()))"
                                           onkeypress="return (event.charCode == 0 || (event.charCode >= 48 && event.charCode <= 57) || event.charCode == 44 || event.charCode == 46)"
                                           style="width: 100%; padding: 8px 12px; border: 1px solid #ddd; border-radius: 4px; font-size: 14px;"
                                           name="MontoRequiredBsInput"
                                           placeholder="0,00"
                                           inputmode="decimal" />

                                    <RadzenNumeric @bind-Value="@Pago.MontoBs"
                                                   Style="display: none;"
                                                   Name="MontoRequiredBsInput" />

                                    <RadzenRequiredValidator Component="MontoRequiredBsInput" Text="El monto bs es requerido" />
                                    <RadzenNumericRangeValidator Min="0.01" Max="999999.99"
                                                                 Component="MontoRequiredBsInput"
                                                                 Text="El monto bs debe ser mayor a 0" />
                                </RadzenStack>
                            </RadzenColumn>

                            <!-- FECHA DE PAGO -->
                            <RadzenColumn Size="12" SizeSM="6">
                                <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                                    <RadzenLabel Text="Fecha Pago" Component="FechaPagoRequiredInput">
                                        Fecha Pago <span style="color: var(--rz-danger);">*</span>
                                    </RadzenLabel>
                                    <RadzenDatePicker @bind-Value="@Pago.FechaPago"
                                                      Name="FechaPagoRequiredInput"
                                                      ShowCalendarWeek="true"
                                                      DateFormat="yyyy-MM-dd"
                                                      ShowTime="false"
                                                      Style="width: 100%;" />
                                    <RadzenRequiredValidator Component="FechaPagoRequiredInput" Text="La fecha de pago es requerida" />
                                </RadzenStack>
                            </RadzenColumn>

                            <!-- COMENTARIO -->
                            <RadzenColumn Size="12" SizeSM="12">
                                <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                                    <RadzenLabel Component="NameRequiredInput">Comentario</RadzenLabel>
                                    <RadzenTextBox Name="NameRequiredInput" @bind-Value=@Pago.Comentario Style="width: 100%;" />
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>

                        <!-- BOTÓN GUARDAR -->
                        <RadzenStack Orientation="Orientation.Horizontal"
                                     JustifyContent="JustifyContent.Center"
                                     Gap="1rem"
                                     Style="flex-wrap: wrap;">
                            <RadzenButton ButtonType="ButtonType.Submit"
                                          Text="Guardar"
                                          Icon="save"
                                          ButtonStyle="ButtonStyle.Success"
                                          Style="width: 100%; max-width: 400px;" />
                            <RadzenButton Text="Cancelar"
                                          Icon="cancel"
                                          ButtonStyle="ButtonStyle.Secondary"
                                          Click="@(() => selectedIndex = 0)"
                                          Style="width: 100%; max-width: 200px;" />
                        </RadzenStack>

                    </RadzenStack>
                </RadzenTemplateForm>


            }

           



            <RadzenDataGrid AllowFiltering="true" AllowColumnResize="true" AllowAlternatingRows="false" FilterMode="FilterMode.Advanced" AllowSorting="true" PageSize="5" AllowPaging="true" PagerHorizontalAlign="HorizontalAlign.Left" ShowPagingSummary="true"
                            Data="@PagosList" ColumnWidth="300px" LogicalFilterOperator="LogicalFilterOperator.Or" SelectionMode="DataGridSelectionMode.Single">
                <Columns>
                    <RadzenDataGridColumn Property="@nameof(Payments.Referencia)" Filterable="false" Title="Referencia" Width="120px" TextAlign="TextAlign.Center" />


                    <RadzenDataGridColumn TItem="Payments"
                                          Property="@nameof(Payments.Monto)"
                                          Title="Monto"
                                          Width="100px">
                        <Template Context="pago">
                            @pago.MontoFormateado $
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="Payments"
                                          Property="@nameof(Payments.MontoBs)"
                                          Title="Monto Bs"
                                          Width="120px">
                        <Template Context="pago">
                            @pago.MontoBsFormateado Bs
                        </Template>
                    </RadzenDataGridColumn>


                    <RadzenDataGridColumn TItem="Payments"
                                          Property="@nameof(Payments.Tasa)"
                                          Title="Tasa"
                                          Width="100px">
                        <Template Context="pago">
                            @pago.Tasa Bs
                        </Template>
                    </RadzenDataGridColumn>

                                       

                    <RadzenDataGridColumn TItem="Payments" Title="Fecha" Width="100px">
                        <Template Context="payment">
                            @payment.FechaPago.ToString("dd/MM/yyyy")
                        </Template>
                    </RadzenDataGridColumn>

                </Columns>
            </RadzenDataGrid>

        </RadzenTabsItem>

       


    </Tabs>
</RadzenTabs>

@code {
    int selectedIndex = 0;
}
