@code {
    bool sidebar1Expanded = false;
    private bool isAuthenticated = false;
    private bool isAdmin = false;
    private string userName = "";
    private HubConnection _hubConnection;

    private int contadorNoLeidas = 0;
    private IEnumerable<Notificaciones> notificaciones;
    private bool mostrarPanel = false;
    private bool _cargado = false;
    private bool _esMobile = false;
    private string? nombreCondominio;
    private string? logoCondominio;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var width = await JSRuntime.InvokeAsync<int>("eval", "window.innerWidth");
                _esMobile = width < 768;
                Console.WriteLine($"📱 Mobile: {_esMobile} ({width}px)");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"❌ Error al detectar mobile: {ex.Message}");
            }
        }
    }


    protected override async Task OnInitializedAsync()
    {

        await UpdateAuthState();


        if (isAuthenticated && AppState.CurrentUser != null)
        {
            // ✅ 1. CARGAMOS EL NOMBRE Y LOGO (Rápido)
            var config = await ConfiguracionCondominioRepository.ObtenerAsync();
            if (config != null)
            {
                nombreCondominio = config.NombreUrbanizacion;
                logoCondominio = config.LogoBase64;
            }

            // ✅ 2. ACTUALIZAMOS LA PANTALLA PARA QUE PINTE EL NOMBRE DE INMEDIATO
            StateHasChanged();

            // ✅ 3. AHORA CONECTAMOS SIGNALR
            await IniciarSignalR();
        }

    }

    private async Task IniciarSignalR()
    {
        try
        {
            await CargarContador();

            // ✅ Sacar el userId de los claims (que sí funcionan)
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var userIdStr = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

            if (string.IsNullOrEmpty(userIdStr))
            {
                Console.WriteLine("❌ No hay userId en los claims");
                return;
            }

            Console.WriteLine($"✅ UserId desde claims: {userIdStr}");

            // ✅ Pasar el userId por query string en la URL del Hub
            var hubUrl = NavigationManager.ToAbsoluteUri($"/notificacionHub?userId={userIdStr}");

            _hubConnection = new HubConnectionBuilder()
                .WithUrl(hubUrl)
                .WithAutomaticReconnect()
                .Build();

            _hubConnection.On("NuevaNotificacion", async () =>
            {
                await InvokeAsync(async () =>
                {
                    await CargarContador();
                    StateHasChanged();
                });
            });

            await _hubConnection.StartAsync();

            Console.WriteLine("═══════════════════════════════════");
            Console.WriteLine($"🔌 CLIENTE CONECTADO");
            Console.WriteLine($"🔌 ConnectionId: '{_hubConnection.ConnectionId}'");
            Console.WriteLine($"🔌 Estado: '{_hubConnection.State}'");
            Console.WriteLine("═══════════════════════════════════");

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error SignalR: {ex.Message}");
        }
    }

    private async Task UpdateAuthState()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        Console.WriteLine("═══════════════════════════════════");
        Console.WriteLine("🔍 UpdateAuthState");
        Console.WriteLine($"👤 ¿Identity existe?: {user.Identity != null}");
        Console.WriteLine($"👤 ¿IsAuthenticated?: {user.Identity?.IsAuthenticated}");
        Console.WriteLine($"👤 Name: '{user.Identity?.Name}'");
        Console.WriteLine($"👤 ¿Cuántos claims?: {user.Claims.Count()}");

        foreach (var claim in user.Claims)
        {
            Console.WriteLine($"   → {claim.Type} = {claim.Value}");
        }

        Console.WriteLine("═══════════════════════════════════");

        isAuthenticated = user.Identity?.IsAuthenticated == true;
        isAdmin = user.IsInRole("Administrador");
        userName = user.Identity?.Name ?? "";
        StateHasChanged();
    }
    private async Task Logout()
    {
        await AuthService.Logout();
        AppState.CurrentUser = null;
        NavigationManager.NavigateTo("/login", true);
    }

 

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
        }
    }

    private async Task CargarContador()
    {
        try
        {
            contadorNoLeidas = await NotificacionRepository.CountUnreadAsync(AppState.CurrentUser.Id);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error al cargar contador: {ex.Message}");
        }
    }

    private async Task TogglePanel()
    {
        mostrarPanel = !mostrarPanel;
        if (mostrarPanel && AppState.CurrentUser != null)
        {
            // ✅ 1. CARGAR NOTIFICACIONES
            var todasLasNotificaciones = await NotificacionRepository.GetByUserAsync(AppState.CurrentUser.Id);
            notificaciones = todasLasNotificaciones.Take(8).ToList(); // 👈 AQUÍ SE LIMITA A 5


            // ✅ 2. MARCAR TODAS COMO LEÍDAS
            await NotificacionRepository.MarcarTodasComoLeidasAsync(AppState.CurrentUser.Id);


            // ✅ 3. ACTUALIZAR EL CONTADOR A 0
            contadorNoLeidas = 0;

            // ✅ 4. ACTUALIZAR EL ESTADO DE LAS NOTIFICACIONES EN MEMORIA
            foreach (var notif in notificaciones)
            {
                notif.IsRead = true;
            }

            StateHasChanged();
        }
        StateHasChanged();
    }

    private async Task MarcarComoLeida(Notificaciones notif)
    {
        if (!notif.IsRead)
        {
            await NotificacionRepository.MarcarComoLeidaAsync(notif.Id);
            notif.IsRead = true;
            await CargarContador();
            StateHasChanged();
        }
    }

    private async Task MarcarTodasComoLeidas()
    {
        await NotificacionRepository.MarcarTodasComoLeidasAsync(AppState.CurrentUser.Id);
        notificaciones = await NotificacionRepository.GetByUserAsync(AppState.CurrentUser.Id);
        await CargarContador();
        StateHasChanged();
    }
    private string ObtenerIcono(string tipo)
    {
        return tipo switch
        {
            "Factura" => "description",
            "Pago" => "payment",
            "Recordatorio" => "schedule",
            "CuotaEspecial" => "receipt_long",
            _ => "notifications"  // Por defecto
        };
    }

    private string ObtenerColor(string tipo)
    {
        return tipo switch
        {
            "Factura" => "#007bff",        // Azul
            "Pago" => "#28a745",           // Verde
            "Recordatorio" => "#ffc107",   // Amarillo
            "CuotaEspecial" => "#6f42c1",  // Morado
            _ => "#6c757d"                 // Gris (por defecto)
        };
    }

    private Task CerrarSidebarSiMobile()
    {
        if (_esMobile)
        {
            sidebar1Expanded = false;
            StateHasChanged();
        }
        return Task.CompletedTask;
    }

    private void CerrarPanel()
    {
        mostrarPanel = false;
        StateHasChanged();
    }
}

    